section WitnessOrdered
variable {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]

theorem witness_L_certificate :
    ∃ A B : K[X], BezoutCertificate (phaseSextic witnessP witnessQ) (phaseLinearOne witnessP witnessQ) A B := by
  rw [witness_sextic, witness_linear]
  exact ⟨_, _, certificate_of_nonzero_constant witness_L_identity (by norm_num)⟩

theorem witness_H_certificate :
    ∃ A B : K[X], BezoutCertificate (phaseSextic witnessP witnessQ) (substitutedPhase witnessP witnessQ witnessH) A B := by
  rw [witness_sextic, witness_pole]
  exact ⟨_, _, certificate_of_nonzero_constant witness_H_identity (by norm_num)⟩

theorem witness_sextic_ne_zero : phaseSextic (witnessP : PhaseRow K) witnessQ ≠ 0 := by
  rw [witness_sextic]
  intro h
  have he := congrArg (fun p : K[X] => p.eval 0) h
  norm_num [witnessS] at he

theorem witness_boundaryT_ne_zero : boundaryT (witnessP : PhaseRow K) witnessQ ≠ 0 := by
  norm_num [boundaryT, resultant₂, witnessP, witnessQ]

theorem witness_boundaryU_ne_zero : boundaryU (witnessP : PhaseRow K) witnessQ ≠ 0 := by
  norm_num [boundaryU, resultant₂, witnessP, witnessQ]

end WitnessOrdered
end W3.Elimination
