theorem witness_sextic : phaseSextic (witnessP : PhaseRow R) witnessQ = witnessS := by
  simp only [phaseSextic, phaseA, phaseB, phaseDiagonal, circlePoly, witnessP, witnessQ, witnessS, quad, map_add, map_mul, map_sub, map_neg, map_ofNat]
  ring

theorem witness_linear : phaseLinearOne (witnessP : PhaseRow R) witnessQ = witnessL := by
  simp only [phaseLinearOne, linearOne, phaseA, phaseB, witnessP, witnessQ, witnessL, quad, map_add, map_mul, map_sub, map_neg, map_ofNat]
  ring

theorem witness_pole : substitutedPhase (witnessP : PhaseRow R) witnessQ witnessH = witnessPole := by
  simp only [substitutedPhase, phaseLinearOne, phaseLinearZero, linearOne, linearZero,
    phaseA, phaseB, phaseC, witnessP, witnessQ, witnessH, witnessPole, quad, map_add, map_mul, map_sub, map_neg, map_ofNat]
  ring

theorem witness_L_identity :
    (witnessLA : R[X]) * witnessS + witnessLB * witnessL = C (1218635122816848539506760857723468163307771808030438339329647752445236440733470720000 : R) := by
  simp only [witnessLA, witnessS, witnessLB, witnessL, map_ofNat]
  ring

theorem witness_H_identity :
    (witnessHA : R[X]) * witnessS + witnessHB * witnessPole = C (256512512491597969267643295821812913446330334819218161172858295968845796982881455484932598088787098899651208399429527057742959045948492114828335046242312795070446210908160000 : R) := by
